# Copy to .env and configure locally. Never commit real .env files.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
API_HOST=127.0.0.1
API_PORT=8000
# Required scheme: postgresql+psycopg. Supply your own development DB, user, and credentials.
DATABASE_URL=
# Required: 32+ varied characters. Generate locally; never paste into chat.
APP_SECRET_KEY=
# Optional fixed synthetic identities, localhost-only. Forbidden in production.
DEV_AUTH_ENABLED=false
# Reserved for later real WeChat integration; currently NOT implemented.
WECHAT_APPID=
WECHAT_APPSECRET=
# Local private storage; never expose this directory as an unguarded static route.
MEDIA_ROOT=./var/media
# Total image body receipt deadline; does not reset for each chunk.
MEDIA_RECEIVE_TIMEOUT_SECONDS=15
# Per-connection PostgreSQL limits, milliseconds. Zero/unbounded values rejected.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
# Maximum wait for an available pooled connection, seconds.
DB_POOL_TIMEOUT_SECONDS=5
