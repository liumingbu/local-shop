# Proposed configuration contract only. There is no runnable application yet.
# Implement validation before relying on these names. Never commit real .env files.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
API_HOST=127.0.0.1
API_PORT=8000
# Fill only inside the protected development environment after the DB is created.
DATABASE_URL=
APP_SECRET_KEY=
# Mock identity is disabled by default and must be forbidden in production.
DEV_AUTH_ENABLED=false
# New project credentials only; do not reuse historical sample values.
WECHAT_APPID=
WECHAT_APPSECRET=
PUBLIC_BASE_URL=
PUBLIC_MEDIA_ROOT=./runtime/public-media
PRIVATE_MEDIA_ROOT=./runtime/private-media
