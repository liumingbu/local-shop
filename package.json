{
  "name": "local-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/admin",
    "apps/miniprogram"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test:native": "npm run build -w apps/miniprogram && node --test tests/miniprogram/*.test.cjs",
    "test:admin": "tsc -p tests/admin/tsconfig.json && node --test tests/admin/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "5.9.3"
  }
}
