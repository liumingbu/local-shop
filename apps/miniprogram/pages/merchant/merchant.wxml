<view class="page"><view class="eyebrow">local-shop · 商户工作台</view><view class="title">{{storeName || '今天要处理什么'}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <picker wx:if="{{members.length>1}}" range="{{memberNames}}" value="{{memberIndex}}" bindchange="choose" disabled="{{busy}}"><view class="field">已授权店铺：{{memberNames[memberIndex]}}</view></picker>
  <block wx:if="{{tenantId}}"><view class="actions"><button bindtap="preparation" disabled="{{busy}}">开店准备</button><button bindtap="settings" disabled="{{busy || role!=='OWNER'}}">店铺资料</button><button bindtap="catalog" disabled="{{busy}}">分类与商品</button><button bindtap="store">看公开店铺</button></view>
    <view class="actions"><button wx:for="{{counts}}" wx:key="name" data-status="{{item.status}}" data-kind="{{item.kind}}" bindtap="filter" disabled="{{busy}}">{{item.name}} {{item.total}}</button></view>
    <view class="card" wx:if="{{form}}"><view class="subtitle">快速代记</view><view class="muted">没建商品库也能先记下来。仅使用合成演示资料。</view>
      <view class="notice" wx:if="{{locked}}">原请求结果未确认，仅可重试原内容。</view>
      <input value="{{form.customer_label}}" data-field="customer_label" bindinput="input" disabled="{{busy || locked}}" maxlength="100" placeholder="顾客称呼（必填，不用于关联账号）"/>
      <input value="{{form.contact_name}}" data-field="contact_name" bindinput="input" disabled="{{busy || locked}}" maxlength="100" placeholder="联系人（不绑定账号）"/><input value="{{form.contact_phone}}" data-field="contact_phone" bindinput="input" disabled="{{busy || locked}}" maxlength="50" placeholder="联系电话"/><textarea wx:if="{{form.fulfillment_method==='DELIVERY'}}" value="{{form.delivery_address}}" data-field="delivery_address" bindinput="input" disabled="{{busy || locked}}" maxlength="500" placeholder="配送地址"/>
      <textarea value="{{form.raw_text}}" data-field="raw_text" bindinput="input" disabled="{{busy || locked}}" maxlength="4000" placeholder="原始需求（必填），数量、单位、要求可以先写在这里"/>
      <picker range="{{sources}}" value="{{sourceIndex}}" bindchange="source" disabled="{{busy || locked}}"><view class="field">来源：{{sources[sourceIndex]}}</view></picker>
      <picker range="{{methods}}" value="{{methodIndex}}" bindchange="method" disabled="{{busy || locked}}"><view class="field">意向：{{methods[methodIndex]}}</view></picker>
      <input value="{{form.expected_time_note}}" data-field="expected_time_note" bindinput="input" disabled="{{busy || locked}}" maxlength="200" placeholder="期望日期／时段（保留原话，不自动推断）"/>
      <picker mode="date" value="{{form.expected_date}}" bindchange="expectedDate" disabled="{{busy || locked}}"><view class="field">顾客明确期望日期：{{form.expected_date || '未指定'}}</view></picker><picker mode="time" value="{{form.expected_clock}}" bindchange="expectedClock" disabled="{{busy || locked}}"><view class="field">顾客明确期望时刻：{{form.expected_clock || '未指定'}}（北京时间）</view></picker><button bindtap="clearExpected" disabled="{{busy || locked}}">清除明确期望时间</button>
      <input value="{{form.internal_note}}" data-field="internal_note" bindinput="input" disabled="{{busy || locked}}" maxlength="2000" placeholder="内部备注（顾客不可见）"/>
      <view wx:for="{{form.items}}" wx:key="index"><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="item" disabled="{{busy || locked}}"/><input value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="item" disabled="{{busy || locked}}" placeholder="数量"/><input value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="item" disabled="{{busy || locked}}" placeholder="单位"/><input value="{{item.spec}}" data-index="{{index}}" data-field="spec" bindinput="item" disabled="{{busy || locked}}" placeholder="规格"/></view>
      <checkbox-group wx:if="{{form.copy_review_required}}" bindchange="reviewed"><label><checkbox value="reviewed"/>已重新核对新需求数量、单位、规格、商品与交付时间</label></checkbox-group>
      <checkbox-group bindchange="confirmed"><label><checkbox value="confirmed" checked="{{form.mark_confirmed}}" disabled="{{busy || locked}}"/>已通过电话等方式明确确认，否则保持待确认</label></checkbox-group>
      <button class="primary" bindtap="create" disabled="{{busy}}">{{locked?'重试原代记':'保存需求'}}</button>
    </view><button wx:if="{{lastId}}" bindtap="latest">查看刚保存的需求</button>
    <view class="card"><view>日期按北京时间；逾期只按商户已确认的精确承诺。</view><view class="actions"><button data-day="" bindtap="dayFilter">全部日期</button><button data-day="today" bindtap="dayFilter">今天</button><button data-day="tomorrow" bindtap="dayFilter">明天</button><button data-day="none" bindtap="dayFilter">未指定</button></view><picker mode="date" data-field="onDate" bindchange="filters"><view class="field">指定日期：{{onDate || '请选择'}}</view></picker><button data-day="date" bindtap="dayFilter">按指定日期查</button><picker range="{{['全部方式','自提','配送']}}" bindchange="methodFilter"><view class="field">交付方式：{{methodFilter || '全部'}}</view></picker><input value="{{search}}" data-field="search" bindinput="filters" maxlength="100" placeholder="顾客称呼、文字、LS业务号"/><button bindtap="load" disabled="{{busy}}">搜索／应用筛选</button><button bindtap="overdueFilter" disabled="{{busy}}">{{overdue?'取消逾期筛选':'仅看已逾承诺时间'}}</button></view>
    <view class="actions"><button data-kind="reservation" data-status="" bindtap="filter" disabled="{{busy}}">全部需求／历史</button><button data-kind="inquiry" data-status="" bindtap="filter" disabled="{{busy}}">全部询货</button></view>
    <view class="card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="subtitle">{{item.label}} · {{item.customer_label || '顾客询货'}}</view><view>{{item.business_number}}</view><view wx:if="{{item.is_overdue}}" class="error">已逾商户承诺时间</view><view class="pre">{{item.raw_text || '图片／商品内容'}}</view><view class="muted">{{item.time}}</view></view>
    <view class="empty" wx:if="{{!records.length && !busy && !error}}">当前筛选没有记录</view>
    <view class="actions"><button bindtap="previous" disabled="{{busy || page<=1}}">上一页</button><text>第 {{page}} 页</text><button bindtap="next" disabled="{{busy || page*20>=total}}">下一页</button></view>
  </block><button bindtap="load" disabled="{{busy}}">刷新待办</button><button bindtap="home">返回入口／登录</button>
  <view class="muted">尚无已验证的微信消息提醒，请主动刷新和联系。这里只是备货交付记录，不涉及支付结算。</view>
</view>
