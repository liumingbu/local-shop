{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "miniprogram-api-typings"
    ],
    "skipLibCheck": true
  },
  "include": [
    "app.ts",
    "config.ts",
    "lib/**/*.ts",
    "pages/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
