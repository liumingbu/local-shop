# Candidate only: release preflight blocks production until real WeChat acceptance.
# Store actual values in a protected server file, never this repository or chat.
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=
APP_SECRET_KEY=
DEV_AUTH_ENABLED=false
MEDIA_ROOT=/srv/local-shop/shared/media
MEDIA_RECEIVE_TIMEOUT_SECONDS=15
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_POOL_TIMEOUT_SECONDS=5
# Protected values remain blank; real integration/production requires separate approval.
WECHAT_LOGIN_ENABLED=false
WECHAT_APPID=
WECHAT_APP_SECRET=
PG_BIN=/usr/lib/postgresql/16/bin

# Empty means direct-peer rate accounting. Only set exact trusted proxy transport IPs
# after verifying API isolation and header overwrite; never wildcard/CIDR.
# This does not change development identity or Uvicorn proxy_headers=False.
AUTH_TRUSTED_PROXY_IPS=
