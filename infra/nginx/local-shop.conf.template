# Include inside nginx http {}. Substitute all named placeholders before nginx -t.
# No media directory or development Web UI is served by this production candidate.
log_format local_shop escape=json '{"time":"$time_iso8601","request_id":"$request_id","app_request_id":"$upstream_http_x_request_id","method":"$request_method","uri":"$uri","status":$status,"seconds":"$request_time"}';
limit_req_zone $binary_remote_addr zone=local_shop_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=local_shop_connections:10m;

upstream local_shop_api {
    server @@API_ADDRESS@@;
    keepalive 8;
}

server {
    listen @@HTTP_BIND@@;
    server_name @@SERVER_NAME@@;
    server_tokens off;
    access_log "@@ACCESS_LOG@@" local_shop;
    return 308 @@PUBLIC_ORIGIN@@$request_uri;
}

server {
    listen @@HTTPS_BIND@@ ssl;
    http2 on;
    server_name @@SERVER_NAME@@;
    server_tokens off;
    ssl_certificate "@@TLS_CERT@@";
    ssl_certificate_key "@@TLS_KEY@@";
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:local_shop_tls:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    access_log "@@ACCESS_LOG@@" local_shop;
    client_max_body_size 2m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /api/v1/dev/ { return 404; }
    location = /docs { return 404; }
    location = /redoc { return 404; }
    location = /openapi.json { return 404; }
    # Every image, including public ones, goes through API association/authorization checks.
    location / { return 404; }
    location /health/ {
        limit_req zone=local_shop_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_pass http://local_shop_api;
    }
    location /api/ {
        limit_req zone=local_shop_requests burst=20 nodelay;
        limit_req_status 429;
        limit_conn local_shop_connections 20;
        limit_conn_status 429;
        error_page 429 = @rate_limited;
        proxy_pass http://local_shop_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite dedicated rate-accounting source with the actual transport peer.
        # API only uses this when this exact proxy peer is configured; never for identity.
        proxy_set_header X-Local-Shop-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_next_upstream off;
    }
    location @rate_limited {
        default_type application/json;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control no-store always;
        add_header Retry-After 2 always;
        return 429 '{"code":"RATE_LIMITED","message":"Try the original request later","request_id":"$request_id"}';
    }
}
